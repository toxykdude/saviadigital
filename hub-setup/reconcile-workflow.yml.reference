# Reconcile safety net: scans pending payments every 15 min and fulfills
# any APPROVED payment whose callback was missed (hub retries dead-letter
# after 24 h; hub cron only repairs rows still PENDING). Keyed endpoint —
# the job self-skips when the secret is absent (forks, pre-setup clones).
name: reconcile-payments

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch: {}

jobs:
  reconcile:
    runs-on: ubuntu-latest
    steps:
      - name: Reconcile pending payments
        env:
          RECONCILE_KEY: ${{ secrets.RECONCILE_KEY }}
          ENDPOINT: https://salvia-form.saviadigital.workers.dev/api/reconcile
        run: |
          if [ -z "$RECONCILE_KEY" ]; then
            echo "RECONCILE_KEY secret not set — skipping."
            exit 0
          fi
          curl -sS --max-time 60 -f -X POST \
            -H "X-Reconcile-Key: $RECONCILE_KEY" \
            -H 'Content-Type: application/json' \
            "$ENDPOINT" -o response.json
          cat response.json
          # Fail loudly on a non-JSON/error body
          jq -e '.ok == true' response.json > /dev/null
